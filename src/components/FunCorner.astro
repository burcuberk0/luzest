---
// "Eğlence köşesi": şans kurabiyesi, melek kartı ve çarklara giden kutucuklar.
import { eglence } from '../data/eglence';
import FunIcon from './FunIcon.astro';
interface Props { exclude?: string; title?: string; compact?: boolean }
const { exclude, title = 'Eğlence köşesi', compact = false } = Astro.props;
const items = eglence.filter((e) => e.href !== exclude);
---
<section class:list={['fun', { compact }]} aria-labelledby="fun-title">
  <h2 id="fun-title">{title}</h2>
  <ul>
    {items.map((e) => (
      <li>
        <a href={e.href} style={`--from:${e.from};--to:${e.to}`}>
          <span class="plate" aria-hidden="true"></span>
          <span class="ic" aria-hidden="true"><FunIcon name={e.art} size={84} /></span>
          <span class="t">{e.title}</span>
          <span class="x">{e.text}</span>
          <span class="go">Dene <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .fun { margin-top: 2rem; }
  .fun h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.9rem; }
  a {
    position: relative; display: flex; flex-direction: column; gap: 0.3rem; height: 100%; min-height: 200px;
    padding: 1.2rem; border-radius: 18px; overflow: hidden; isolation: isolate;
    background: linear-gradient(140deg, var(--from), var(--to));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  a::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 0% 100%, rgba(255,255,255,0.45), transparent 55%); }
  a:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.6), 0 14px 30px rgba(42,31,45,0.14); }
  .plate {
    position: absolute; z-index: -1; right: -18px; top: -18px; width: 132px; height: 132px; border-radius: 50%;
    background: radial-gradient(circle at 45% 55%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.55) 45%, rgba(255,255,255,0) 72%);
    transition: transform 0.4s ease;
  }
  a:hover .plate { transform: scale(1.12); }
  .ic { align-self: flex-end; width: 84px; height: 84px; margin: -0.3rem -0.2rem 0.2rem 0; filter: drop-shadow(0 6px 10px rgba(42,31,45,0.12)); }
  a:hover .ic :global(.fi-move) { transform: translateY(-5px) rotate(-7deg) scale(1.08); }
  .t { margin-top: auto; font-family: var(--font-display); font-size: 1.3rem; line-height: 1.15; }
  .x { font-size: 0.875rem; color: var(--ink-soft); line-height: 1.45; }
  .go { margin-top: 0.5rem; font-size: 0.8125rem; font-weight: 600; color: var(--ink); opacity: 0.75; transition: opacity 0.2s, transform 0.2s; }
  a:hover .go { opacity: 1; transform: translateX(3px); color: var(--accent-deep); }
  .compact h2 { font-size: 1.35rem; }
  @media (max-width: 640px) {
    ul { grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    a { min-height: 170px; padding: 0.9rem; border-radius: 14px; }
    .ic, .ic :global(svg) { width: 64px; height: 64px; }
    .plate { width: 104px; height: 104px; right: -14px; top: -14px; }
    .x { display: none; }
    .t { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) { a, .plate, .go { transition: none; } }
</style>
