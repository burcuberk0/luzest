---
// "Eğlence köşesi": şans kurabiyesi, melek kartı ve çarklara giden kutucuklar.
import { eglence } from '../data/eglence';
interface Props { exclude?: string; title?: string; compact?: boolean }
const { exclude, title = 'Eğlence köşesi', compact = false } = Astro.props;
const items = eglence.filter((e) => e.href !== exclude);
---
<section class:list={['fun', { compact }]} aria-labelledby="fun-title">
  <h2 id="fun-title">{title}</h2>
  <ul>
    {items.map((e) => (
      <li>
        <a href={e.href} style={`--from:${e.from};--to:${e.to}`}>
          <span class="ic" aria-hidden="true">{e.icon}</span>
          <span class="t">{e.title}</span>
          <span class="x">{e.text}</span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .fun { margin-top: 2rem; }
  .fun h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.9rem; }
  a {
    position: relative; display: flex; flex-direction: column; gap: 0.25rem; height: 100%;
    padding: 1.1rem 1.2rem 1.2rem; border-radius: 14px; overflow: hidden;
    background: linear-gradient(135deg, var(--from), var(--to));
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  a:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(42,31,45,0.12); }
  a:hover .ic { transform: rotate(-12deg) scale(1.15); }
  .ic { font-size: 1.9rem; line-height: 1; margin-bottom: 0.4rem; transition: transform 0.3s cubic-bezier(.3,1.6,.5,1); color: #9a7b3f; display: inline-block; width: fit-content; }
  .t { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.15; }
  .x { font-size: 0.875rem; color: var(--ink-soft); }
  .go { position: absolute; right: 1rem; top: 1rem; font-weight: 600; opacity: 0.6; }
  .compact h2 { font-size: 1.35rem; }
  @media (max-width: 640px) {
    ul { grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    a { padding: 0.9rem; }
    .x { display: none; }
    .t { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) { a, .ic { transition: none; } }
</style>
