---
// "Bugün neye ihtiyacın var?" şeridi: okuru ihtiyacına göre doğru alt bölüme götürür.
// Bağlantıları değiştirmek için aşağıdaki listeyi düzenle.
const items = [
  { title: 'Kombin fikri', href: '/kategori/moda/kombin-rehberi/', icon: 'hanger' },
  { title: 'Kısa bir kaçamak', href: '/kategori/seyahat/hafta-sonu-kacamagi/', icon: 'plane' },
  { title: 'Kolay tarif', href: '/kategori/yemek/kolay-tarifler/', icon: 'pot' },
  { title: 'Kendime zaman', href: '/kategori/yasam/zihin-beden/', icon: 'lotus' },
];
---
<nav class="need" aria-label="Bugün neye ihtiyacın var?">
  <svg class="burst" width="34" height="26" viewBox="0 0 34 26" aria-hidden="true"><path d="M4 22 1 13M13 14 9 3M22 20l7-9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <p class="q">Bugün neye ihtiyacın var?</p>
  <ul>
    {items.map((it) => (
      <li>
        <a href={it.href}>
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            {it.icon === 'hanger' && <path d="M17 9.5a2.6 2.6 0 1 1 2.6-2.6c0 1.3-2.6 1.8-2.6 3.6v1.3M17 11.8 3.5 22.5c-.9.7-.4 2 .7 2h25.6c1.1 0 1.6-1.3.7-2L17 11.8Z" />}
            {it.icon === 'plane' && <path d="m4 15.5 4.2 1.6 6.5-3.4-4.8 6.3 1.4 6 2.6-4.4 6.1 2.4L31 6 4 15.5Zm13.4.2L31 6M11.3 26l3.9-5.2" />}
            {it.icon === 'pot' && <path d="M6 13h22v9.5a5 5 0 0 1-5 5H11a5 5 0 0 1-5-5V13Zm-3 0h28M13.5 13V11a3.5 3.5 0 0 1 7 0v2M17 4.5v2" />}
            {it.icon === 'lotus' && <path d="M17 26c-3-2.5-4.5-6-4.5-9.5S14.5 9.5 17 7.5c2.5 2 4.5 5.5 4.5 9S20 23.5 17 26Zm0 0c-4.5.3-9-1.6-11.5-6 2-.8 4.6-.9 7-.2M17 26c4.5.3 9-1.6 11.5-6-2-.8-4.6-.9-7-.2M17 26c-5.5 0-11-2-14-5.5M17 26c5.5 0 11-2 14-5.5" />}
          </svg>
          <span>{it.title}</span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .need { position: relative; margin-top: 2.6rem; display: flex; align-items: center; gap: 1.2rem 2rem; padding: 1rem 1.6rem; border-radius: 16px; background: var(--accent-soft); }
  .burst { position: absolute; left: 0.9rem; top: -1.4rem; color: var(--accent); }
  .q { margin: 0; flex: none; padding-right: 1.6rem; border-right: 1.5px solid rgba(36,28,26,0.35); font-family: var(--font-display); font-style: italic; font-size: clamp(1.35rem, 2.2vw, 1.75rem); line-height: 1.2; transform: skewX(-2deg); }
  ul { list-style: none; margin: 0; padding: 0; flex: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  a { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.4rem; white-space: nowrap; border-radius: 10px; font-weight: 500; font-size: 0.9375rem; transition: background 0.2s; }
  a svg { flex: none; color: var(--accent-deep); }
  a:hover { background: rgba(255,255,255,0.6); }
  .go { margin-left: auto; transition: transform 0.2s; }
  a:hover .go { transform: translateX(3px); }
  @media (max-width: 1180px) {
    .need { flex-direction: column; align-items: stretch; }
    .q { border-right: 0; padding-right: 0; }
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .need { padding: 1.1rem 1rem 0.9rem; margin-top: 2.2rem; }
    .q { font-size: 1.3rem; padding-left: 0.2rem; }
    a { padding: 0.65rem 0.6rem; background: rgba(255,255,255,0.55); font-size: 0.9rem; gap: 0.45rem; }
    a svg { width: 26px; height: 26px; }
    .go { display: none; }
  }
</style>
