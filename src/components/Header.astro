---
import { site, categories } from '../config.mjs';
const path = Astro.url.pathname;

// Aktif kategori sponsorlarını Sanity'den çek (tarih aralığı GROQ'ta kontrol edilir).
// Hata olursa sessizce boş döner; nav sponsor olmadan render edilir.
const SANITY_PROJECT = 'u5wvkla5';
const SANITY_DATASET = 'production';
const sponsorQuery = `*[_type == "categorySponsor"
  && defined(logo)
  && (!defined(startDate) || startDate <= now())
  && (!defined(endDate) || endDate >= now())
]{ category, name, url, "logo": logo.asset->url }`;

type Sponsor = { category: string; name: string; url?: string; logo: string };
let sponsors: Record<string, Sponsor> = {};
try {
  const res = await fetch(
    `https://${SANITY_PROJECT}.api.sanity.io/v2024-01-01/data/query/${SANITY_DATASET}?query=${encodeURIComponent(sponsorQuery)}`
  );
  if (res.ok) {
    const { result } = (await res.json()) as { result: Sponsor[] };
    for (const s of result ?? []) sponsors[s.category] = s;
  }
} catch {}
---
<header class="site-header">
  <div class="wrap top">
    <ul class="social" aria-label="Sosyal medya">
      {site.instagram && (
        <li><a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg>
        </a></li>
      )}
      {site.pinterest && (
        <li><a href={site.pinterest} target="_blank" rel="noopener" aria-label="Pinterest">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-3.46 18.35c-.08-.75-.16-1.9.03-2.72l1.2-5.1s-.3-.62-.3-1.53c0-1.43.83-2.5 1.87-2.5.88 0 1.3.66 1.3 1.45 0 .88-.56 2.2-.85 3.43-.24 1.02.52 1.86 1.53 1.86 1.84 0 3.25-1.94 3.25-4.73 0-2.47-1.78-4.2-4.31-4.2-2.94 0-4.66 2.2-4.66 4.48 0 .89.34 1.84.77 2.36.08.1.1.2.07.3l-.29 1.17c-.04.19-.15.23-.34.14-1.28-.6-2.08-2.47-2.08-3.98 0-3.24 2.35-6.21 6.78-6.21 3.56 0 6.32 2.53 6.32 5.92 0 3.54-2.23 6.38-5.32 6.38-1.04 0-2.02-.54-2.35-1.18l-.64 2.44c-.23.89-.86 2.01-1.28 2.69A9.5 9.5 0 1 0 12 2.5z" fill="currentColor"/></svg>
        </a></li>
      )}
    </ul>
    <div class="brand">
      <a class="wordmark" href="/" aria-label={`${site.name} ana sayfa`}>
        Luzest
        <svg class="swoosh" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10.5C30 4 70 2.5 117 5.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
      </a>
      <p class="tagline">{site.tagline}</p>
    </div>
    <div class="top-end">
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="bars" aria-hidden="true"></span>
        <span class="label">Menü</span>
      </button>
    </div>
  </div>

  <nav id="site-nav" class="wrap nav" aria-label="Kategoriler">
    <ul class="cats">
      {categories.map((c) => {
        const active = path.startsWith(`/kategori/${c.slug}`);
        const sp = sponsors[c.slug];
        return (
          <li class={`cat tint-${c.slug}`}>
            <a href={`/kategori/${c.slug}/`} class="cat-link" aria-current={active ? 'page' : undefined}>{c.title}</a>
            {sp && (
              <span class="sponsor">
                <span class="sponsor-by">by</span>
                {sp.url ? (
                  <a href={sp.url} target="_blank" rel="sponsored noopener" aria-label={`${c.title} sponsoru: ${sp.name}`}>
                    <img src={sp.logo} alt={sp.name} loading="lazy" />
                  </a>
                ) : (
                  <img src={sp.logo} alt={sp.name} loading="lazy" />
                )}
              </span>
            )}
            <button class="sub-toggle" type="button" aria-expanded="false" aria-label={`${c.title} alt bölümleri`}>
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>
            <ul class="subs">
              <li class="subs-all"><a href={`/kategori/${c.slug}/`}>Tümü</a></li>
              {c.subs.map((s) => (
                <li><a href={`/kategori/${c.slug}/${s.slug}/`}>{s.title}</a></li>
              ))}
              {(c.extras ?? []).map((x) => (
                <li class="subs-extra"><a href={x.href}>{x.title}</a></li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector('.menu-btn') as HTMLButtonElement | null;
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('open', !open);
  });

  // Alt bölümler: masaüstünde hover, dokunmatikte ve mobilde tıklamayla açılır.
  document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((t) => {
    t.addEventListener('click', (e) => {
      e.preventDefault();
      const li = t.closest('.cat')!;
      const open = li.classList.contains('open');
      document.querySelectorAll('.cat.open').forEach((o) => { o.classList.remove('open'); o.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false'); });
      if (!open) { li.classList.add('open'); t.setAttribute('aria-expanded', 'true'); }
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.cat')) {
      document.querySelectorAll('.cat.open').forEach((o) => { o.classList.remove('open'); o.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false'); });
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('.cat.open').forEach((o) => o.classList.remove('open'));
  });
</script>

<style>
  .site-header { position: relative; z-index: 20; background: var(--paper); }
  .top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: 1.3rem 0 1rem; border-bottom: 1px solid var(--line); }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.9rem; }
  .social a { display: flex; color: var(--ink); }
  .social a:hover { color: var(--accent-deep); }
  .brand { text-align: center; }
  .wordmark {
    position: relative; display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    font-variation-settings: 'opsz' 144, 'SOFT' 0;
  }
  .swoosh { position: absolute; left: 52%; right: -10%; bottom: 0.02em; width: 58%; height: 0.22em; color: var(--accent); }
  .tagline { margin: 0.35rem 0 0; color: var(--ink); font-size: 1rem; letter-spacing: 0.04em; }
  .top-end { display: flex; justify-content: flex-end; }
  .menu-btn { display: none; }

  .cats { list-style: none; margin: 0; padding: 0.35rem 0; display: flex; gap: clamp(0.6rem, 3vw, 3.4rem); flex-wrap: wrap; justify-content: center; }
  .nav { border-bottom: 1px solid var(--line); }
  .cat { position: relative; display: flex; align-items: center; }
  .cat-link { position: relative; display: inline-block; padding: 0.6rem 0.15rem 0.6rem 0.4rem; font-weight: 500; font-size: 1.0625rem; white-space: nowrap; }
  .cat-link::after { content: ''; position: absolute; left: 0.4rem; right: 0.15rem; bottom: 0.3rem; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.2s ease; }
  .cat:hover .cat-link::after, .cat-link[aria-current="page"]::after { transform: scaleX(1); }
  .sub-toggle { border: 0; background: transparent; padding: 0.4rem 0.3rem; cursor: pointer; color: var(--ink-soft); display: flex; align-items: center; opacity: 0.6; }
  .cat:hover .sub-toggle { opacity: 1; }
  .cat.open .sub-toggle svg { transform: rotate(180deg); }

  /* Kategori sponsoru */
  .sponsor { display: inline-flex; align-items: center; gap: 0.3rem; padding-left: 0.2rem; }
  .sponsor-by { font-size: 0.75rem; font-style: italic; color: var(--ink-soft); }
  .sponsor a { display: inline-flex; align-items: center; }
  .sponsor img { height: 1.25rem; width: auto; max-width: 5.5rem; display: block; object-fit: contain; }

  .subs {
    list-style: none; margin: 0; padding: 0.5rem;
    position: absolute; top: 100%; left: 0; min-width: 12rem;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: 0 10px 30px rgba(36, 28, 26, 0.12);
    display: none;
  }
  .cat.open .subs { display: block; }
  @media (hover: hover) { .cat:hover .subs { display: block; } }
  .subs a { display: block; padding: 0.5rem 0.75rem; border-radius: 8px; font-size: 1rem; }
  .subs a:hover { background: var(--tint); }
  .subs-all a { font-weight: 600; }
  .subs-extra { border-top: 1px solid var(--line); margin-top: 0.3rem; padding-top: 0.3rem; }
  .subs-extra a::before { content: '✦ '; color: var(--accent-deep); }

  @media (max-width: 720px) {
    .top { grid-template-columns: auto 1fr auto; padding: 0.9rem 0 0.8rem; }
    .social { gap: 0.6rem; }
    .social svg { width: 18px; height: 18px; }
    .wordmark { font-size: 2.4rem; }
    .tagline { font-size: 0.8125rem; }
    .menu-btn {
      display: flex; align-items: center; gap: 0.45rem;
      border: 1.5px solid var(--line); background: transparent; border-radius: 999px;
      padding: 0.45rem 0.8rem; font: inherit; font-weight: 600; font-size: 0.875rem; cursor: pointer; color: var(--ink);
    }
    .menu-btn .label { display: none; }
    .bars { width: 16px; height: 2px; background: var(--ink); box-shadow: 0 -5px 0 var(--ink), 0 5px 0 var(--ink); display: block; margin: 5px 0; }
    .nav { display: none; border-bottom: 1px solid var(--line); }
    .site-header.open .nav { display: block; }
    .cats { flex-direction: column; gap: 0.15rem; padding: 0.5rem 0 1rem; }
    .cat { flex-wrap: wrap; border-radius: 10px; }
    .cat-link { flex: 1; padding: 0.6rem 0.8rem; font-size: 1.05rem; }
    .cat-link::after { display: none; }
    .sponsor img { height: 1.4rem; }
    .sub-toggle { padding: 0.6rem 0.9rem; opacity: 1; }
    .cat.open { background: var(--tint); }
    .subs { position: static; box-shadow: none; border: 0; background: transparent; width: 100%; padding: 0 0.4rem 0.6rem; }
    .subs a { padding-left: 1rem; }
  }
</style>
