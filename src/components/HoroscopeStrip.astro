---
import type { Post } from '../lib/sanity';
import { formatDate } from '../lib/sanity';
interface Props { post?: Post | null }
const { post } = Astro.props;
---
{post && (
  <a class="strip tint-astroloji" href={`/yazi/${post.slug}/`}>
    <span class="star" aria-hidden="true">✦</span>
    <span class="label">Bu haftanın burcu</span>
    <span class="title">{post.title}</span>
    <span class="date">{formatDate(post.publishedAt)}</span>
    <span class="go" aria-hidden="true">→</span>
  </a>
)}

<style>
  .strip {
    display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;
    margin-top: 1.4rem; padding: 0.8rem 1.2rem; border-radius: 999px; background: var(--tint);
    font-size: 0.9375rem;
  }
  .strip:hover .title { text-decoration: underline; text-underline-offset: 0.15em; }
  .star { color: var(--accent-deep); }
  .label { font-weight: 600; }
  .title { font-family: var(--font-display); font-size: 1.1rem; }
  .date { color: var(--ink-soft); font-size: 0.8125rem; margin-left: auto; }
  .go { color: var(--ink-soft); }
  @media (max-width: 640px) { .date { display: none; } .strip { border-radius: 12px; } }
</style>
