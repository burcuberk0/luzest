---
// Açık (ön yüz) melek kartı görseli. Detay sayfasında ve listelerde kullanılır.
interface Props { name: string; symbol: string; size?: 'sm' | 'lg' }
const { name, symbol, size = 'sm' } = Astro.props;
---
<div class={`mk-face ${size}`} aria-hidden="true">
  <span class="sym">{symbol}</span>
  <span class="nm">{name}</span>
</div>

<style>
  .mk-face {
    aspect-ratio: 2 / 3; border-radius: 10px; padding: 8%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6em;
    background:
      radial-gradient(circle at 50% 38%, rgba(255,255,255,0.95) 0 30%, transparent 62%),
      linear-gradient(160deg, #fbf3e6 0%, #f3d9e1 55%, #e1daf0 100%);
    box-shadow: inset 0 0 0 1.5px #d9c9a3, inset 0 0 0 6px #fff, inset 0 0 0 7px #e6d8b8, 0 6px 18px rgba(42,31,45,0.12);
    color: var(--ink); text-align: center;
  }
  .sym { font-size: 2.2em; line-height: 1; color: #9a7b3f; }
  .nm { font-family: var(--font-display); font-size: 1.1em; line-height: 1.15; font-variation-settings: 'opsz' 96, 'SOFT' 100; }
  .lg { font-size: clamp(1.2rem, 3vw, 1.6rem); }
  .sm { font-size: 0.95rem; }
</style>
