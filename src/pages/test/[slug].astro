---
import Base from '../../layouts/Base.astro';
import FunCorner from '../../components/FunCorner.astro';
import { getAllQuizzes, type Quiz } from '../../lib/sanity';
import { categoryBySlug, site } from '../../config.mjs';

export async function getStaticPaths() {
  const quizzes = await getAllQuizzes();
  return quizzes.map((q) => ({ params: { slug: q.slug }, props: { quiz: q } }));
}
const { quiz } = Astro.props as { quiz: Quiz };
const category = categoryBySlug(quiz.category);
const from = quiz.colorFrom ?? '#fbe0d0';
const to = quiz.colorTo ?? '#f3d9e1';
const sp = quiz.sponsor;
const url = new URL(`/test/${quiz.slug}/`, site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: quiz.title,
  description: quiz.seoDescription ?? quiz.intro,
  url,
  publisher: { '@type': 'Organization', name: site.name },
};
---
<Base title={quiz.seoTitle ?? quiz.title} description={quiz.seoDescription ?? quiz.intro}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap">
    <nav class="crumb" aria-label="Konum">
      <a href="/test/">Testler</a>
      {category && <><span aria-hidden="true">/</span><a href={`/kategori/${category.slug}/`}>{category.title}</a></>}
    </nav>

    <section class="qz" id="qz" style={`--from:${from};--to:${to}`} data-slug={quiz.slug} data-sponsor={sp?.name ?? ''}>
      {sp && (
        <div class="ad">
          <span class="ad-pill">{sp.label}</span>
          {sp.url ? (
            <a class="ad-brand" href={sp.url} target="_blank" rel="sponsored noopener">
              {sp.logo ? <img src={sp.logo} alt={sp.name} height="22" /> : <strong>{sp.name}</strong>}
              <span>sunar</span>
            </a>
          ) : (
            <span class="ad-brand">{sp.logo ? <img src={sp.logo} alt={sp.name} height="22" /> : <strong>{sp.name}</strong>}<span>sunar</span></span>
          )}
        </div>
      )}

      <!-- Giriş -->
      <div class="screen" data-screen="intro">
        {quiz.emoji && <div class="big-emoji" aria-hidden="true">{quiz.emoji}</div>}
        <h1>{quiz.title}</h1>
        <p class="lede">{quiz.intro}</p>
        <p class="meta"><span>⏱ 1 dakika</span><span>❓ {quiz.questions.length} soru</span><span>✦ {quiz.results.length} sonuç</span></p>
        <button class="btn btn-lg" type="button" data-act="start">Teste başla</button>
      </div>

      <!-- Sorular -->
      <div class="screen" data-screen="q" hidden>
        <div class="progress" aria-hidden="true"><i id="qz-bar"></i></div>
        <p class="step"><span id="qz-step"></span></p>
        <h2 id="qz-question" tabindex="-1"></h2>
        <div class="opts" id="qz-opts" role="list"></div>
        <button class="back" type="button" data-act="back" id="qz-back">← Önceki soru</button>
      </div>

      <!-- Sonuç -->
      <div class="screen" data-screen="result" hidden>
        <p class="kicker">Sonucun</p>
        <div class="res-card" id="qz-card">
          <div class="res-emoji" id="qz-r-emoji" aria-hidden="true"></div>
          <h2 id="qz-r-title" tabindex="-1"></h2>
          <p class="motto" id="qz-r-motto"></p>
        </div>
        <div class="res-body" id="qz-r-body"></div>
        <ul class="traits" id="qz-r-traits"></ul>

        <aside class="rec" id="qz-rec" hidden>
          {sp && <p class="rec-top"><span>Senin tipine özel</span><span class="rec-ad">{sp.label} · {sp.name}</span></p>}
          <h3 id="qz-rec-h"></h3>
          <p id="qz-rec-t"></p>
          <a class="btn" id="qz-rec-a" href="#"></a>
        </aside>

        <div class="actions">
          <button class="btn" type="button" data-act="share">Hikâyende paylaş</button>
          <button class="btn btn-ghost" type="button" data-act="again">Tekrar çöz</button>
        </div>
        <p class="toast" id="qz-toast" role="status" aria-live="polite"></p>
      </div>
    </section>

    <FunCorner title="Bunlar da hoşuna gidebilir" />
  </div>

  <script type="application/json" id="qz-data" set:html={JSON.stringify({ q: quiz.questions, r: quiz.results, from, to, title: quiz.title, slug: quiz.slug, sponsor: sp?.name ?? '' })} />
</Base>

<script>
  import { shareCard } from '../../scripts/share-card';

  type Opt = { emoji?: string; text: string; result: string };
  type Res = { key: string; title: string; emoji?: string; motto?: string; body?: string; traits?: string[]; colorFrom?: string; colorTo?: string;
    recommendation?: { headline?: string; text?: string; ctaText?: string; url?: string } };
  const D: { q: { question: string; options: Opt[] }[]; r: Res[]; from: string; to: string; title: string; slug: string; sponsor: string } =
    JSON.parse(document.getElementById('qz-data')!.textContent || '{}');

  const $ = (id: string) => document.getElementById(id)!;
  const root = $('qz');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = 0;
  let answers: number[] = [];
  let result: Res | null = null;

  const track = (event: string, extra: Record<string, unknown> = {}) =>
    (window as any).dataLayer?.push({ event, quiz_id: D.slug, quiz_sponsor: D.sponsor || 'yok', ...extra });

  const show = (name: string) => {
    root.querySelectorAll<HTMLElement>('.screen').forEach((s) => {
      const on = s.dataset.screen === name;
      s.hidden = !on;
      if (on && !reduce) { s.classList.remove('in'); void s.offsetWidth; s.classList.add('in'); }
    });
    root.dataset.state = name;
  };

  const renderQ = () => {
    const Q = D.q[i];
    const pct = Math.round((i / D.q.length) * 100);
    ($('qz-bar') as HTMLElement).style.width = `${pct}%`;
    $('qz-step').textContent = `Soru ${i + 1} / ${D.q.length}`;
    $('qz-question').textContent = Q.question;
    const box = $('qz-opts');
    box.innerHTML = '';
    Q.options.forEach((o, k) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'opt' + (answers[i] === k ? ' sel' : '');
      b.setAttribute('role', 'listitem');
      b.innerHTML = `<span class="e" aria-hidden="true"></span><span class="t"></span>`;
      (b.querySelector('.e') as HTMLElement).textContent = o.emoji ?? '•';
      (b.querySelector('.t') as HTMLElement).textContent = o.text;
      b.addEventListener('click', () => choose(k, b));
      box.appendChild(b);
    });
    ($('qz-back') as HTMLElement).style.visibility = i > 0 ? 'visible' : 'hidden';
    show('q');
    ($('qz-question') as HTMLElement).focus({ preventScroll: true });
  };

  const choose = (k: number, el: HTMLElement) => {
    answers[i] = k;
    el.classList.add('sel');
    track('quiz_answer', { quiz_question: i + 1, quiz_option: k + 1 });
    root.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => (b.disabled = true));
    setTimeout(() => { i++; i < D.q.length ? renderQ() : finish(); }, reduce ? 0 : 260);
  };

  const finish = () => {
    const score: Record<string, number> = {};
    D.r.forEach((r) => (score[r.key] = 0));
    answers.forEach((a, idx) => { const k = D.q[idx].options[a]?.result; if (k in score) score[k]++; });
    // Eşitlikte, sonuç listesinde önce gelen kazanır.
    result = D.r.reduce((best, r) => (score[r.key] > score[best.key] ? r : best), D.r[0]);
    const R = result;
    const card = $('qz-card') as HTMLElement;
    card.style.setProperty('--rf', R.colorFrom ?? D.from);
    card.style.setProperty('--rt', R.colorTo ?? D.to);
    $('qz-r-emoji').textContent = R.emoji ?? '✦';
    $('qz-r-title').textContent = R.title;
    $('qz-r-motto').textContent = R.motto ? `“${R.motto}”` : '';
    const body = $('qz-r-body');
    body.innerHTML = '';
    (R.body ?? '').split(/\n\s*\n/).filter(Boolean).forEach((p) => { const el = document.createElement('p'); el.textContent = p.trim(); body.appendChild(el); });
    const tr = $('qz-r-traits');
    tr.innerHTML = '';
    (R.traits ?? []).forEach((t) => { const li = document.createElement('li'); li.textContent = t; tr.appendChild(li); });

    const rec = R.recommendation;
    const recBox = $('qz-rec') as HTMLElement;
    if (rec?.headline && rec?.url) {
      $('qz-rec-h').textContent = rec.headline;
      $('qz-rec-t').textContent = rec.text ?? '';
      const a = $('qz-rec-a') as HTMLAnchorElement;
      a.textContent = rec.ctaText || 'Keşfet';
      let href = rec.url;
      const external = /^https?:\/\//.test(href);
      if (external) {
        const u = new URL(href);
        u.searchParams.set('utm_source', 'luzest');
        u.searchParams.set('utm_medium', 'quiz');
        u.searchParams.set('utm_campaign', D.slug);
        u.searchParams.set('utm_content', R.key);
        href = u.href;
        a.target = '_blank';
        a.rel = D.sponsor ? 'sponsored noopener' : 'noopener';
      } else { a.removeAttribute('target'); a.removeAttribute('rel'); }
      a.href = href;
      recBox.hidden = false;
    } else recBox.hidden = true;

    track('quiz_complete', { quiz_result: R.key });
    show('result');
    root.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    ($('qz-r-title') as HTMLElement).focus({ preventScroll: true });
  };

  root.addEventListener('click', async (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
    if (act === 'start') { i = 0; answers = []; track('quiz_start'); renderQ(); }
    else if (act === 'back' && i > 0) { i--; renderQ(); }
    else if (act === 'again') { track('quiz_restart'); show('intro'); }
    else if (act === 'share' && result) {
      track('quiz_share', { quiz_result: result.key });
      const r = await shareCard({
        eyebrow: D.title,
        title: `${result.emoji ? result.emoji + ' ' : ''}${result.title}`,
        text: result.motto,
        extra: 'Sen hangisisin?',
        from: result.colorFrom ?? D.from, to: result.colorTo ?? D.to,
        url: `luzest.com/test/${D.slug}`,
        filename: `luzest-${D.slug}.png`,
      });
      $('qz-toast').textContent = r === 'downloaded' ? 'Görsel indirildi; hikâyene ekleyebilirsin.' : r === 'failed' ? 'Görsel oluşturulamadı.' : '';
    }
  });
  $('qz-rec-a').addEventListener('click', () => track('quiz_cta_click', { quiz_result: result?.key }));
</script>

<style>
  .crumb { display: flex; gap: 0.5rem; margin: 1.6rem 0 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .crumb a:hover { color: var(--accent-deep); }

  .qz { max-width: 680px; margin: 1rem auto 0; padding: 2.4rem clamp(1.1rem, 4vw, 2.6rem) 2.6rem; border-radius: 22px;
    background: radial-gradient(circle at 20% 10%, rgba(255,255,255,0.75), transparent 55%), linear-gradient(140deg, var(--from), var(--to)); }

  .ad { display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin-bottom: 1.4rem; font-size: 0.8125rem; }
  .ad-pill { text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; font-size: 0.6875rem; padding: 0.2rem 0.55rem; border-radius: 999px; background: rgba(255,255,255,0.75); color: var(--accent-deep); }
  .ad-brand { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--ink); }
  .ad-brand img { height: 22px; width: auto; }

  .screen.in { animation: fadeUp 0.4s ease both; }
  [data-screen="intro"] { text-align: center; }
  .big-emoji { font-size: 3.6rem; line-height: 1; margin-bottom: 0.8rem; animation: float 3s ease-in-out infinite; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); }
  .lede { margin: 0.8rem auto 0; max-width: 34ch; color: var(--ink-soft); font-size: 1.125rem; }
  .meta { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin: 1.1rem 0 1.6rem; font-size: 0.9375rem; color: var(--ink-soft); }
  .btn-lg { padding: 0.95rem 2.2rem; font-size: 1.0625rem; }
  .btn-ghost { background: rgba(255,255,255,0.6); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: var(--paper); }

  .progress { height: 6px; border-radius: 99px; background: rgba(255,255,255,0.6); overflow: hidden; }
  .progress i { display: block; height: 100%; width: 0; background: var(--ink); border-radius: 99px; transition: width 0.35s ease; }
  .step { margin: 0.6rem 0 1rem; font-size: 0.875rem; color: var(--ink-soft); font-weight: 600; }
  [data-screen="q"] h2 { font-size: clamp(1.45rem, 3.6vw, 1.9rem); margin: 0 0 1.2rem; outline: none; }
  .opts { display: grid; gap: 0.6rem; }
  .qz :global(.opt) { all: unset; box-sizing: border-box; display: flex; align-items: center; gap: 0.8rem; width: 100%; padding: 0.95rem 1.1rem; border-radius: 14px;
    background: rgba(255,255,255,0.82); box-shadow: inset 0 0 0 1.5px rgba(42,31,45,0.08); cursor: pointer; font-size: 1.0625rem; line-height: 1.35;
    transition: transform 0.12s ease, box-shadow 0.15s ease, background 0.15s ease; }
  .qz :global(.opt:hover) { background: #fff; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .qz :global(.opt:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .qz :global(.opt:active) { transform: scale(0.985); }
  .qz :global(.opt.sel) { background: var(--ink); color: var(--paper); }
  .qz :global(.opt .e) { font-size: 1.4rem; width: 1.8rem; text-align: center; flex: none; }
  .back { all: unset; cursor: pointer; margin-top: 1.1rem; font-size: 0.9375rem; color: var(--ink-soft); }
  .back:hover { color: var(--ink); }

  .kicker { text-align: center; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8125rem; font-weight: 600; color: var(--ink-soft); margin: 0 0 0.7rem; }
  .res-card { text-align: center; padding: 2rem 1.4rem; border-radius: 18px; background: linear-gradient(140deg, var(--rf, #fff), var(--rt, #fff)); box-shadow: 0 14px 34px rgba(42,31,45,0.12), inset 0 0 0 6px rgba(255,255,255,0.55); }
  .res-emoji { font-size: 3.4rem; line-height: 1; margin-bottom: 0.5rem; }
  .res-card h2 { font-size: clamp(2rem, 5.5vw, 2.8rem); margin: 0; outline: none; }
  .motto { margin: 0.6rem auto 0; max-width: 32ch; font-family: var(--font-display); font-style: italic; font-size: 1.125rem; color: var(--ink); }
  .res-body { margin-top: 1.6rem; font-size: 1.0625rem; }
  .res-body :global(p) { margin: 0 0 0.9rem; }
  .traits { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; padding: 0; margin: 0.4rem 0 1.6rem; }
  .traits :global(li) { padding: 0.3rem 0.8rem; border-radius: 999px; background: rgba(255,255,255,0.7); font-weight: 600; font-size: 0.875rem; }

  .rec { padding: 1.3rem 1.3rem 1.4rem; border-radius: 16px; background: rgba(255,255,255,0.88); margin-bottom: 1.4rem; }
  .rec-top { display: flex; justify-content: space-between; gap: 1rem; margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-deep); }
  .rec-ad { color: var(--ink-soft); }
  .rec h3 { font-size: 1.35rem; margin: 0 0 0.4rem; }
  .rec p { margin: 0 0 1rem; color: var(--ink-soft); }

  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
  .toast { margin: 0.8rem 0 0; min-height: 1.2em; text-align: center; font-size: 0.875rem; color: var(--ink-soft); }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .big-emoji { animation: none; } .progress i { transition: none; } }
</style>
