---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import HoroscopeStrip from '../components/HoroscopeStrip.astro';
import { getAllPosts } from '../lib/sanity';
import { categories, horoscope } from '../config.mjs';

const posts = await getAllPosts();
const hero = posts.find((p) => p.featured) ?? posts[0];
const weekly = posts.find((p) => p.category === horoscope.category && p.sub === `${horoscope.category}/${horoscope.sub}`);
const rest = posts.filter((p) => p !== hero);
const latest = rest.slice(0, 6);
const byCategory = categories
  .map((c) => ({ ...c, posts: posts.filter((p) => p.category === c.slug).slice(0, 3) }))
  .filter((c) => c.posts.length > 0);
---
<Base>
  <div class="wrap">
    <HoroscopeStrip post={weekly} />

    {hero ? (
      <section class="hero">
        <PostCard post={hero} size="large" />
      </section>
    ) : (
      <section class="empty">
        <h1>Yakında burada.</h1>
        <p>İlk yazılar hazırlanıyor. Yönetim panelinden bir yazı yayınladığında ana sayfa kendiliğinden dolacak.</p>
      </section>
    )}

    {latest.length > 0 && (
      <section class="section">
        <h2>Son yazılar</h2>
        <div class="grid">
          {latest.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )}

    <Newsletter />

    {byCategory.map((c) => (
      <section class={`section band tint-${c.slug}`}>
        <div class="band-head">
          <h2><a href={`/kategori/${c.slug}/`}>{c.title}</a></h2>
          <p>{c.blurb}</p>
          <a class="more" href={`/kategori/${c.slug}/`}>Tümünü gör →</a>
        </div>
        <div class="grid">
          {c.posts.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .hero { padding: 2rem 0 1rem; }
  .empty { padding: 5rem 0; max-width: 40ch; }
  .empty h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin-bottom: 1rem; }
  .empty p { color: var(--ink-soft); }
  .section { padding: 3rem 0 0; }
  .section > h2 { font-size: 1.9rem; margin-bottom: 1.4rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem 1.6rem; }
  .band { margin-top: 3rem; padding: 2rem var(--gutter) 2.4rem; border-radius: 10px; background: var(--tint); }
  .band-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .band-head h2 { font-size: 1.9rem; }
  .band-head h2 a:hover { color: var(--accent-deep); }
  .band-head p { margin: 0; color: var(--ink-soft); }
  .more { margin-left: auto; font-weight: 600; font-size: 0.9375rem; }
  .more:hover { color: var(--accent-deep); }
</style>
