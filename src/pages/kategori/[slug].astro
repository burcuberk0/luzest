---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { eglence } from '../../data/eglence';
import { categories } from '../../config.mjs';
import { getPostsByCategory } from '../../lib/sanity';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}
const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug);
---
<Base title={category.title} description={`${category.title} — ${category.blurb}`}>
  <div class="wrap">
    <header class={`head tint-${category.slug}`}>
      <h1>{category.title}</h1>
      <p>{category.blurb}</p>
      <nav class="subnav" aria-label={`${category.title} alt bölümleri`}>
        <a href={`/kategori/${category.slug}/`} aria-current="page">Tümü</a>
        {category.subs.map((s) => <a href={`/kategori/${category.slug}/${s.slug}/`}>{s.title}</a>)}
        {(category.extras ?? []).map((x) => <a href={x.href}>✦ {x.title}</a>)}
      </nav>
    </header>
    {(category.extras ?? []).length > 0 && (
      <div class="fun">
        {category.extras.map((x) => {
          const e = eglence.find((f) => f.href === x.href);
          return (
            <a class="fun-strip" href={x.href} style={e ? `--from:${e.from};--to:${e.to}` : ''}>
              <span class="fun-ic" aria-hidden="true">{e?.icon ?? '✦'}</span>
              <span class="fun-t">{x.title}</span>
              {e && <span class="fun-x">{e.text}</span>}
              <span class="fun-go">Dene →</span>
            </a>
          );
        })}
      </div>
    )}
    {posts.length > 0 ? (
      <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
    ) : (
      <p class="empty">Bu bölümde henüz yazı yok. İlk yazı yayınlandığında burada görünecek.</p>
    )}
  </div>
</Base>

<style>
  .head { margin: 2rem 0 2.5rem; padding: 2.5rem var(--gutter) 2rem; border-radius: 10px; background: var(--tint); }
  .head h1 { font-size: clamp(2.4rem, 6vw, 4rem); }
  .head p { margin: 0.6rem 0 0; color: var(--ink-soft); font-size: 1.125rem; }
  .subnav { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.4rem; }
  .subnav a { padding: 0.35rem 0.85rem; border-radius: 999px; background: rgba(255,255,255,0.55); font-weight: 600; font-size: 0.9375rem; }
  .subnav a:hover, .subnav a[aria-current="page"] { background: var(--ink); color: var(--paper); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem 1.6rem; }
  .fun { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.8rem; margin: -1.5rem 0 2.5rem; }
  .fun-strip { display: flex; align-items: center; gap: 0.8rem; padding: 0.8rem 1.2rem; border-radius: 999px; background: linear-gradient(100deg, var(--from, var(--paper-warm)), var(--to, var(--paper-warm))); }
  .fun-strip:hover .fun-go { color: var(--accent-deep); }
  .fun-ic { font-size: 1.4rem; color: #9a7b3f; }
  .fun-t { font-weight: 600; }
  .fun-x { font-family: var(--font-display); color: var(--ink-soft); }
  .fun-go { margin-left: auto; font-weight: 600; white-space: nowrap; }
  @media (max-width: 640px) { .fun-x { display: none; } .fun-strip { border-radius: 12px; } }
  .empty { color: var(--ink-soft); padding: 2rem 0 4rem; }
</style>
