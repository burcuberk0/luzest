---
import Base from '../layouts/Base.astro';
import FunCorner from '../components/FunCorner.astro';
import { kureCevaplari } from '../data/sihirli-kure';
import { site } from '../config.mjs';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Evet mi Hayır mı? Sihirli Küre',
  description: 'İçinden bir soru tut, sihirli küreye dokun; evet, hayır, belki ya da asla… Cevabını öğren.',
  url: new URL('/evet-mi-hayir-mi/', site.url).href,
  publisher: { '@type': 'Organization', name: site.name },
};
---
<Base title="Evet mi Hayır mı? Sihirli Küre — İçinden Bir Soru Tut" description="İçinden bir soru tut, sihirli küreye dokun; kesinlikle evet, belki, asla… Sihirli küre cevabını söylesin.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap">
    <section class="hero" id="sk-hero" data-state="idle">
      <div class="stars" aria-hidden="true">{Array.from({ length: 24 }, () => <i></i>)}</div>
      <p class="crumbs"><a href="/kategori/astroloji/">Astroloji</a> <span aria-hidden="true">/</span> Sihirli Küre</p>
      <h1>Evet mi Hayır mı?</h1>
      <p class="lede">İçinden bir soru tut. Evet ya da hayırla cevaplanabilecek bir soru olsun. Sonra küreye dokun.</p>

      <label class="ask">
        <span class="sr">Sorun (isteğe bağlı)</span>
        <input id="sk-q" type="text" maxlength="90" placeholder="Sorunu yaz (istersen)" autocomplete="off" />
      </label>

      <div class="orb-wrap">
        <button class="orb" id="sk-orb" type="button" aria-label="Küreye dokun ve cevabını al">
          <span class="glass">
            <span class="mist m1" aria-hidden="true"></span>
            <span class="mist m2" aria-hidden="true"></span>
            <span class="mist m3" aria-hidden="true"></span>
            <span class="shine" aria-hidden="true"></span>
            <span class="answer" id="sk-answer" aria-hidden="true"></span>
            <span class="tap" aria-hidden="true">Dokun</span>
          </span>
        </button>
        <span class="base" aria-hidden="true"><i></i></span>
      </div>

      <div class="result" id="sk-result" hidden>
        <p class="r-q" id="sk-rq"></p>
        <p class="r-note" id="sk-note"></p>
        <div class="actions">
          <button class="btn" type="button" id="sk-again">Yeni soru sor</button>
          <button class="btn btn-ghost" type="button" id="sk-share">Hikâyende paylaş</button>
        </div>
        <p class="toast" id="sk-toast"></p>
      </div>
      <p class="sr" id="sk-status" role="status" aria-live="polite"></p>
    </section>

    <section class="about article-body">
      <h2>Sihirli küre nasıl çalışır?</h2>
      <p>Bazen bir karar için tek ihtiyacımız olan şey küçük bir dürtü. “Ona yazayım mı?”, “Bu hafta sonu kaçamak yapayım mı?”, “O elbiseyi alayım mı?”… Ben de kararsız kaldığımda içimden bir soru tutup bir cevap beklerim; cevaptan çok, cevabı duyduğum andaki hissime bakarım.</p>
      <p>Sihirli küre de tam bunun için. Sorunu içinden tut, küreye dokun ve cevabını oku. Cevap içini rahatlattıysa muhtemelen zaten bunu istiyordun; hayal kırıklığı yarattıysa, belki de kalbin diğer tarafta. Küre eğlencesine; son söz her zaman senin.</p>
      <h3>Hangi soruları sormalı?</h3>
      <p>Evet ya da hayırla cevaplanabilecek her soru olur. “Ne zaman?” ya da “Kim?” gibi açık uçlu sorular yerine, “Bu ay yeni bir şeye başlamalı mıyım?” gibi net sorular daha eğlenceli sonuçlar verir.</p>
    </section>

    <FunCorner exclude="/evet-mi-hayir-mi/" title="Bunlar da hoşuna gidebilir" />
  </div>

  <script type="application/json" id="sk-data" set:html={JSON.stringify(kureCevaplari)} />
</Base>

<script>
  import { shareCard } from '../scripts/share-card';
  type Cevap = { text: string; type: 'evet' | 'belki' | 'hayir'; note: string };
  const cevaplar: Cevap[] = JSON.parse(document.getElementById('sk-data')!.textContent || '[]');
  const $ = (id: string) => document.getElementById(id)!;
  const hero = $('sk-hero');
  const orb = $('sk-orb') as HTMLButtonElement;
  const input = $('sk-q') as HTMLInputElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let last = -1;
  let current: { c: Cevap; q: string } | null = null;

  const ask = () => {
    if (hero.dataset.state === 'thinking') return;
    let i = Math.floor(Math.random() * cevaplar.length);
    if (i === last) i = (i + 1) % cevaplar.length;
    last = i;
    const c = cevaplar[i];
    const q = input.value.trim();
    current = { c, q };
    hero.dataset.state = 'thinking';
    hero.dataset.type = '';
    $('sk-result').hidden = true;
    orb.disabled = true;
    (window as any).dataLayer?.push({ event: 'sihirli_kure_soruldu', cevap_tipi: c.type });
    setTimeout(() => {
      $('sk-answer').textContent = c.text;
      $('sk-rq').textContent = q ? `“${q}”` : 'İçinden tuttuğun soru için küre diyor ki…';
      $('sk-note').textContent = c.note;
      $('sk-toast').textContent = '';
      $('sk-status').textContent = `Cevap: ${c.text}. ${c.note}`;
      hero.dataset.type = c.type;
      hero.dataset.state = 'answered';
      $('sk-result').hidden = false;
      orb.disabled = false;
    }, reduce ? 0 : 1900);
  };

  orb.addEventListener('click', ask);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); ask(); } });
  $('sk-again').addEventListener('click', () => {
    hero.dataset.state = 'idle';
    hero.dataset.type = '';
    $('sk-result').hidden = true;
    $('sk-answer').textContent = '';
    input.value = '';
    input.focus();
  });
  $('sk-share').addEventListener('click', async () => {
    if (!current) return;
    const palette = { evet: ['#d6f0e0', '#b9d9f3'], belki: ['#efe0f7', '#f9dcc4'], hayir: ['#f6d4dc', '#d9cbef'] }[current.c.type];
    const r = await shareCard({
      eyebrow: 'Sihirli küre diyor ki',
      title: current.c.text,
      text: current.q ? `Sorum: ${current.q}` : current.c.note,
      extra: current.q ? current.c.note : undefined,
      from: palette[0], to: palette[1],
      url: 'luzest.com/evet-mi-hayir-mi',
      filename: 'luzest-sihirli-kure.png',
    });
    $('sk-toast').textContent = r === 'downloaded' ? 'Görsel indirildi; hikâyene ekleyebilirsin.' : r === 'failed' ? 'Görsel oluşturulamadı.' : '';
  });
</script>

<style>
  .hero {
    --glow: 190, 160, 255;
    position: relative; margin: 2rem 0 0; padding: 2.2rem var(--gutter) 3rem; border-radius: 16px; text-align: center; overflow: hidden; color: #fff;
    background: radial-gradient(circle at 50% 62%, #4a3a78 0%, #2b2050 45%, #1a1430 100%);
    transition: background 0.8s ease;
  }
  .hero[data-type='evet'] { --glow: 120, 230, 180; }
  .hero[data-type='belki'] { --glow: 255, 200, 120; }
  .hero[data-type='hayir'] { --glow: 255, 120, 150; }
  .crumbs { position: relative; margin: 0 0 0.8rem; font-size: 0.875rem; color: rgba(255,255,255,0.7); }
  .crumbs a { font-weight: 600; color: #fff; }
  h1 { position: relative; font-size: clamp(2.4rem, 6vw, 4rem); color: #fff; }
  .lede { position: relative; margin: 0.7rem auto 0; max-width: 48ch; color: rgba(255,255,255,0.8); font-size: 1.0625rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .ask { position: relative; display: block; max-width: 460px; margin: 1.4rem auto 0; }
  .ask input {
    width: 100%; padding: 0.85rem 1.2rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.1); color: #fff; font: inherit; text-align: center; outline: none; backdrop-filter: blur(4px);
  }
  .ask input::placeholder { color: rgba(255,255,255,0.55); }
  .ask input:focus { border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.16); }

  .orb-wrap { position: relative; width: min(300px, 70vw); margin: 2rem auto 0; }
  .orb { all: unset; cursor: pointer; display: block; width: 100%; aspect-ratio: 1; border-radius: 50%; position: relative; z-index: 2; animation: hover 4s ease-in-out infinite; }
  .orb:focus-visible { outline: 3px solid #fff; outline-offset: 6px; }
  .glass {
    position: absolute; inset: 0; border-radius: 50%; overflow: hidden; display: grid; place-items: center;
    background:
      radial-gradient(circle at 35% 30%, rgba(255,255,255,0.55) 0 8%, transparent 22%),
      radial-gradient(circle at 50% 55%, rgba(var(--glow), 0.55) 0%, rgba(var(--glow), 0.18) 45%, rgba(20,12,40,0.9) 78%);
    box-shadow: inset 0 -18px 40px rgba(0,0,0,0.45), inset 0 10px 30px rgba(255,255,255,0.15), 0 0 60px rgba(var(--glow), 0.45), 0 0 140px rgba(var(--glow), 0.2);
    transition: box-shadow 0.8s ease, background 0.8s ease;
  }
  .orb:hover .glass { box-shadow: inset 0 -18px 40px rgba(0,0,0,0.45), inset 0 10px 30px rgba(255,255,255,0.15), 0 0 80px rgba(var(--glow), 0.65), 0 0 180px rgba(var(--glow), 0.3); }
  .mist { position: absolute; border-radius: 50%; filter: blur(18px); opacity: 0.55; mix-blend-mode: screen; }
  .m1 { width: 70%; height: 45%; left: 5%; top: 30%; background: rgba(var(--glow), 0.7); animation: drift1 9s ease-in-out infinite; }
  .m2 { width: 55%; height: 55%; right: 0; top: 15%; background: rgba(255, 170, 220, 0.5); animation: drift2 11s ease-in-out infinite; }
  .m3 { width: 60%; height: 35%; left: 20%; bottom: 8%; background: rgba(140, 200, 255, 0.45); animation: drift3 13s ease-in-out infinite; }
  .shine { position: absolute; width: 30%; height: 16%; left: 20%; top: 14%; border-radius: 50%; background: rgba(255,255,255,0.5); filter: blur(6px); transform: rotate(-30deg); }
  .tap { position: relative; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.8125rem; color: rgba(255,255,255,0.85); animation: pulse 1.8s ease-in-out infinite; }
  .answer {
    position: absolute; inset: 18%; display: grid; place-items: center; text-align: center;
    font-family: var(--font-display); font-size: clamp(1.4rem, 5vw, 2rem); line-height: 1.1; color: #fff;
    text-shadow: 0 0 18px rgba(var(--glow), 0.9), 0 2px 6px rgba(0,0,0,0.5); opacity: 0; transform: scale(0.6);
  }
  .base { position: absolute; z-index: 1; left: 50%; bottom: -26px; width: 62%; height: 54px; transform: translateX(-50%); }
  .base i { position: absolute; inset: 0; border-radius: 50% 50% 14px 14px / 60% 60% 14px 14px; background: linear-gradient(180deg, #c9a24b, #7d5a1f); box-shadow: 0 14px 30px rgba(0,0,0,0.45); }
  .base::before { content: ''; position: absolute; left: 50%; top: -10px; width: 70%; height: 20px; transform: translateX(-50%); border-radius: 50%; background: #e2c27a; z-index: 1; }

  .hero[data-state='thinking'] .orb { animation: shake 0.5s ease-in-out 3; }
  .hero[data-state='thinking'] .mist { animation-duration: 1.4s, 1.6s, 1.8s; opacity: 0.85; }
  .hero[data-state='thinking'] .tap { opacity: 0; animation: none; }
  .hero[data-state='answered'] .tap { opacity: 0; animation: none; }
  .hero[data-state='answered'] .answer { animation: reveal 0.9s cubic-bezier(.2,1.2,.3,1) forwards; }
  .hero[data-state='answered'] .mist { opacity: 0.35; }

  .result { position: relative; margin: 3rem auto 0; max-width: 520px; animation: fadeUp 0.6s 0.3s both; }
  .r-q { margin: 0; font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: rgba(255,255,255,0.85); }
  .r-note { margin: 0.5rem 0 1.3rem; font-size: 1.0625rem; color: #fff; }
  .actions { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
  .actions .btn { background: #fff; color: #2a1f2d; }
  .actions .btn:hover { background: rgb(var(--glow)); }
  .btn-ghost { background: transparent !important; color: #fff !important; box-shadow: inset 0 0 0 1.5px #fff; }
  .btn-ghost:hover { background: rgba(255,255,255,0.15) !important; }
  .toast { margin: 0.7rem 0 0; min-height: 1.2em; font-size: 0.875rem; color: rgba(255,255,255,0.75); }

  .stars i { position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #fff; opacity: 0.6; animation: twinkle 3s ease-in-out infinite; }
  .stars i:nth-child(3n) { width: 3px; height: 3px; animation-delay: 1s; }
  .stars i:nth-child(4n) { animation-delay: 2s; animation-duration: 4s; }
  .stars i:nth-child(1) { left: 6%; top: 12%; } .stars i:nth-child(2) { left: 14%; top: 40%; } .stars i:nth-child(3) { left: 9%; top: 72%; }
  .stars i:nth-child(4) { left: 22%; top: 22%; } .stars i:nth-child(5) { left: 28%; top: 62%; } .stars i:nth-child(6) { left: 18%; top: 88%; }
  .stars i:nth-child(7) { left: 35%; top: 8%; } .stars i:nth-child(8) { left: 40%; top: 80%; } .stars i:nth-child(9) { left: 48%; top: 4%; }
  .stars i:nth-child(10) { left: 58%; top: 90%; } .stars i:nth-child(11) { left: 64%; top: 10%; } .stars i:nth-child(12) { left: 70%; top: 70%; }
  .stars i:nth-child(13) { left: 76%; top: 28%; } .stars i:nth-child(14) { left: 82%; top: 54%; } .stars i:nth-child(15) { left: 88%; top: 16%; }
  .stars i:nth-child(16) { left: 93%; top: 40%; } .stars i:nth-child(17) { left: 90%; top: 82%; } .stars i:nth-child(18) { left: 3%; top: 52%; }
  .stars i:nth-child(19) { left: 52%; top: 60%; } .stars i:nth-child(20) { left: 31%; top: 36%; } .stars i:nth-child(21) { left: 68%; top: 44%; }
  .stars i:nth-child(22) { left: 44%; top: 30%; } .stars i:nth-child(23) { left: 12%; top: 6%; } .stars i:nth-child(24) { left: 86%; top: 94%; }

  @keyframes hover { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @keyframes shake { 0%,100% { transform: translate(0,0) rotate(0); } 25% { transform: translate(-6px,2px) rotate(-3deg); } 50% { transform: translate(5px,-2px) rotate(3deg); } 75% { transform: translate(-3px,1px) rotate(-1deg); } }
  @keyframes drift1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(30%, -20%) scale(1.2); } }
  @keyframes drift2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-35%, 25%) scale(0.85); } }
  @keyframes drift3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-20%, -40%) scale(1.15); } }
  @keyframes pulse { 0%,100% { opacity: 0.9; } 50% { opacity: 0.35; } }
  @keyframes reveal { 0% { opacity: 0; transform: scale(0.4); filter: blur(10px); } 100% { opacity: 1; transform: scale(1); filter: blur(0); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes twinkle { 0%,100% { opacity: 0.2; } 50% { opacity: 0.9; } }

  @media (prefers-reduced-motion: reduce) {
    .orb, .mist, .tap, .stars i, .result { animation: none !important; }
    .hero[data-state='answered'] .answer { animation: none; opacity: 1; transform: none; }
  }

  .about { margin: 3.5rem auto 0; }
  .about h2 { margin-top: 0; }
</style>
