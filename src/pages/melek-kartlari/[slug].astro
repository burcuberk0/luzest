---
import Base from '../../layouts/Base.astro';
import MelekKartFace from '../../components/MelekKartFace.astro';
import { melekKartlari, type MelekKarti } from '../../data/melek-kartlari';
import { site } from '../../config.mjs';

export async function getStaticPaths() {
  return melekKartlari.map((k, i) => ({
    params: { slug: k.slug },
    props: {
      kart: k,
      prev: melekKartlari[(i - 1 + melekKartlari.length) % melekKartlari.length],
      next: melekKartlari[(i + 1) % melekKartlari.length],
    },
  }));
}
interface Props { kart: MelekKarti; prev: MelekKarti; next: MelekKarti }
const { kart, prev, next } = Astro.props;

// Sayfanın altında gösterilecek 6 kart: listede bu karttan sonraki kartlar (deterministik).
const idx = melekKartlari.findIndex((k) => k.slug === kart.slug);
const others = Array.from({ length: 6 }, (_, n) => melekKartlari[(idx + 2 + n * 7) % melekKartlari.length])
  .filter((k, i, arr) => k.slug !== kart.slug && arr.findIndex((x) => x.slug === k.slug) === i);

const url = new URL(`/melek-kartlari/${kart.slug}/`, site.url).href;
const description = `${kart.name} melek kartı anlamı: ${kart.keyword} ${kart.message.split('. ')[0]}.`.slice(0, 158);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${kart.name} Melek Kartı Anlamı`,
    description,
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Astroloji', item: new URL('/kategori/astroloji/', site.url).href },
      { '@type': 'ListItem', position: 2, name: 'Melek Kartları', item: new URL('/melek-kartlari/', site.url).href },
      { '@type': 'ListItem', position: 3, name: kart.name, item: url },
    ],
  },
];
---
<Base title={`${kart.name} Melek Kartı Anlamı`} description={description} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="wrap">
    <p class="crumbs">
      <a href="/kategori/astroloji/">Astroloji</a> <span aria-hidden="true">/</span>
      <a href="/melek-kartlari/">Melek Kartları</a> <span aria-hidden="true">/</span>
      {kart.name}
    </p>

    <header class="hero">
      <div class="visual"><MelekKartFace name={kart.name} symbol={kart.symbol} size="lg" /></div>
      <div class="intro">
        <p class="eyebrow">Melek kartı</p>
        <h1>{kart.name} Melek Kartı Anlamı</h1>
        <p class="kw">{kart.keyword}</p>
        <p class="msg">{kart.message}</p>
      </div>
    </header>

    <div class="parts">
      <section class="part tint-ask-iliskiler">
        <h2>Aşk &amp; İlişkiler</h2>
        <p>{kart.love}</p>
      </section>
      <section class="part tint-yemek">
        <h2>İş &amp; Para</h2>
        <p>{kart.career}</p>
      </section>
      <section class="part tint-yasam">
        <h2>Bugün için</h2>
        <p>{kart.advice}</p>
      </section>
    </div>

    <aside class="cta">
      <p class="cta-title">Bugün hangi kart seni bekliyor?</p>
      <p class="cta-text">Bir soru düşün, {melekKartlari.length} kart arasından kendi kartını seç.</p>
      <a class="btn" href="/melek-kartlari/">Günün kartını çek</a>
    </aside>

    <nav class="pager" aria-label="Diğer kartlar">
      <a href={`/melek-kartlari/${prev.slug}/`} rel="prev"><span>← Önceki kart</span><strong>{prev.name}</strong></a>
      <a href={`/melek-kartlari/${next.slug}/`} rel="next" class="nx"><span>Sonraki kart →</span><strong>{next.name}</strong></a>
    </nav>

    <section class="more">
      <h2>Diğer melek kartları</h2>
      <ul>
        {others.map((k) => (
          <li>
            <a href={`/melek-kartlari/${k.slug}/`}>
              <MelekKartFace name={k.name} symbol={k.symbol} />
              <span class="more-kw">{k.keyword}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="all-link"><a href="/melek-kartlari/#mk-all">Tüm kartlar ve anlamları →</a></p>
    </section>
  </article>
</Base>

<style>
  .crumbs { margin: 2rem 0 1.5rem; font-size: 0.875rem; color: var(--ink-soft); }
  .crumbs a { font-weight: 600; }
  .crumbs a:hover { color: var(--accent-deep); }

  .hero { display: grid; grid-template-columns: minmax(160px, 240px) 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; padding: 2rem var(--gutter); border-radius: 12px; background: linear-gradient(120deg, var(--tint-astroloji), #f3e6ee); }
  .visual { max-width: 240px; width: 100%; }
  .eyebrow { margin: 0 0 0.4rem; font-weight: 600; font-size: 0.875rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .kw { margin: 0.6rem 0 0; font-family: var(--font-display); font-style: italic; font-size: 1.35rem; color: var(--accent-deep); }
  .msg { margin: 1rem 0 0; font-size: 1.125rem; line-height: 1.75; max-width: 58ch; }
  @media (max-width: 640px) { .hero { grid-template-columns: 1fr; text-align: center; } .visual { margin: 0 auto; max-width: 170px; } .msg { margin-inline: auto; } }

  .parts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .part { padding: 1.4rem 1.5rem; border-radius: 10px; background: var(--tint); }
  .part h2 { font-size: 1.35rem; margin-bottom: 0.5rem; }
  .part p { margin: 0; line-height: 1.65; }

  .cta { margin: 2.5rem 0 0; padding: 2rem var(--gutter); border-radius: 12px; background: #3a2b55; color: #fff; text-align: center; }
  .cta-title { margin: 0; font-family: var(--font-display); font-size: 1.7rem; }
  .cta-text { margin: 0.4rem 0 1.2rem; opacity: 0.85; }
  .cta .btn { background: #e8d9b0; color: #2a1f2d; }
  .cta .btn:hover { background: #fff; }

  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding: 1.2rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; }
  .pager span { font-size: 0.8125rem; color: var(--ink-soft); }
  .pager strong { font-family: var(--font-display); font-weight: 500; font-size: 1.25rem; }
  .pager a:hover strong { color: var(--accent-deep); }
  .pager .nx { text-align: right; }

  .more { margin-top: 3rem; }
  .more h2 { font-size: 1.9rem; margin-bottom: 1.4rem; }
  .more ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 1.2rem; }
  .more li a { display: flex; flex-direction: column; gap: 0.5rem; }
  .more li a:hover .more-kw { color: var(--accent-deep); }
  .more-kw { font-size: 0.875rem; color: var(--ink-soft); text-align: center; }
  .all-link { margin: 1.6rem 0 0; font-weight: 600; }
  .all-link a:hover { color: var(--accent-deep); }
</style>
